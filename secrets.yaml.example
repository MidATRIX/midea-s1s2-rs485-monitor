# midea-s1s2-rs485-monitor
#
# Copy to  secrets.yaml  (repo root, next to example_midea_s1s2.yaml) and fill
# it in. The ESP (ESPHome) and tools/s1s2_capture.py both read this file, so
# they always agree. secrets.yaml is gitignored.
#
# More settings (MQTT port, topic, InfluxDB org/bucket/...) have defaults and
# can be added here if you need them - see docs/SETUP.md.

# --- WiFi (ESP) ---------------------------------------------------------
wifi_ssid: "YourNetwork"
wifi_password: "YourWiFiPassword"

# --- MQTT (ESP + capture) -----------------------------------------------
# IP of your MQTT broker (Mosquitto, HA's Mosquitto add-on, ...).
# Running the capture with --amqtt instead? Put the IP of the PC running it.
mqtt_broker: "127.0.0.1"
# Must match your broker's login. With --amqtt these ARE the login.
mqtt_user: "midea-s1s2"
mqtt_pass: "midea-s1s2"

# --- InfluxDB (capture) -------------------------------------------------
# Where InfluxDB runs - e.g. your Home Assistant host if you use HA's InfluxDB
# add-on. Default if removed: http://127.0.0.1:8086
influx_url: "http://127.0.0.1:8086"
influx_token: "PASTE_YOUR_INFLUX_API_TOKEN"
